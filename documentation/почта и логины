# src/services/mail_config.py
from dataclasses import dataclass
import os
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from src.db.models import Setting

@dataclass
class MailConfig:
    enabled: bool
    from_addr: str
    host: str
    port: int
    user: str
    password: str
    starttls: bool

async def load_mail_config(session: AsyncSession) -> MailConfig:
    # Сначала .env как дефолт, потом перекрываем из БД settings
    defaults = {
        "MAIL_ENABLED": os.getenv("MAIL_ENABLED", "false"),
        "MAIL_FROM": os.getenv("MAIL_FROM", "noreply@example.com"),
        "MAIL_SMTP_HOST": os.getenv("MAIL_SMTP_HOST", "smtp.example.com"),
        "MAIL_SMTP_PORT": os.getenv("MAIL_SMTP_PORT", "587"),
        "MAIL_SMTP_USER": os.getenv("MAIL_SMTP_USER", ""),
        "MAIL_SMTP_PASSWORD": os.getenv("MAIL_SMTP_PASSWORD", ""),
        "MAIL_SMTP_STARTTLS": os.getenv("MAIL_SMTP_STARTTLS", "true"),
    }
    rows = (await session.execute(select(Setting))).scalars().all()
    for r in rows:
        if r.key in defaults:
            defaults[r.key] = r.value

    return MailConfig(
        enabled=defaults["MAIL_ENABLED"].lower() == "true",
        from_addr=defaults["MAIL_FROM"],
        host=defaults["MAIL_SMTP_HOST"],
        port=int(defaults["MAIL_SMTP_PORT"]),
        user=defaults["MAIL_SMTP_USER"],
        password=defaults["MAIL_SMTP_PASSWORD"],
        starttls=defaults["MAIL_SMTP_STARTTLS"].lower() == "true",
    )

3) Отправка писем
# src/services/mailer.py
import aiosmtplib
from email.message import EmailMessage
from src.services.mail_config import MailConfig

async def send_mail(cfg: MailConfig, to_email: str, subject: str, html: str, text: str | None = None):
    if not cfg.enabled:
        raise RuntimeError("Mail disabled in settings")

    msg = EmailMessage()
    msg["From"] = cfg.from_addr
    msg["To"] = to_email
    msg["Subject"] = subject
    if text:
        msg.set_content(text)
    msg.add_alternative(html, subtype="html")

    if cfg.starttls:
        await aiosmtplib.send(
            msg, hostname=cfg.host, port=cfg.port,
            start_tls=True, username=cfg.user, password=cfg.password
        )
    else:
        await aiosmtplib.send(
            msg, hostname=cfg.host, port=cfg.port,
            start_tls=False, username=cfg.user, password=cfg.password
        )

